{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build libDaisy",
            "type": "shell",
            "command": "make -C libDaisy",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build DaisySP",
            "type": "shell",
            "command": "make -C DaisySP",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean"
        },
        {
            "label": "program-dfu",
            "type": "shell",
            "command": "make program-dfu",
            "dependsOn": "build"
        }
    ]
}
